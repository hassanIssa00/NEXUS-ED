# Public HTTPS origin of the deployed Nexus API. The app appends /api when absent.
EXPO_PUBLIC_NEXUS_API_URL=https://nexus-edu-api.vercel.app/api

# Public Firebase client configuration for the existing Nexus Firebase project.
# These are client identifiers, not Admin SDK credentials or private keys.
# Keep Firebase Auth authorized domains and Firestore rules restricted to the app.
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=nexus-edu-ikhlas-jeddah-2026.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=nexus-edu-ikhlas-jeddah-2026
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=nexus-edu-ikhlas-jeddah-2026.firebasestorage.app
