# Use only Oracle OCI resources labelled Always Free. Do not enable Pay As You Go.
# Set the domain DNS A record to the VM public IP and allow inbound TCP 80/443.
DOMAIN_NAME=nexus.masarplatform.org

POSTGRES_DB=nexus
POSTGRES_USER=nexus
# Use URL-safe random text (hex is recommended) so it can be embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-secret

# Generate both independently: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters

PUBLIC_SCHOOL_SLUG=al-ikhlas-jeddah
NEXUS_SCHOOL_NAME=مدارس الإخلاص الأهلية بجدة

# Optional one-time initial administrator. Use a real school-controlled mailbox.
# Both values must be set together; the seed refuses to overwrite existing users.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Required for Google sign-in and API password-reset delivery.
GOOGLE_CLIENT_ID=replace-with-the-real-google-oauth-web-client-id.apps.googleusercontent.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-a-school-mailbox@gmail.com
SMTP_PASS=replace-with-a-mail-provider-app-password
SMTP_FROM_NAME=Nexus EDU
SMTP_FROM_EMAIL=replace-with-a-verified-school-sender@example.com

# Firebase public web configuration. These values are not server secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nexus-edu-ikhlas-jeddah-2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Private file uploads remain disabled until a private bucket and server-only key are verified.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
