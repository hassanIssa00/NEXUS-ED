generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  latitude    Float?
  longitude   Float?
  attendanceRadiusMeters Int @default(50)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  classes     Class[]
  subjects    Subject[]
  invoices    Invoice[]
  assignments Assignment[]
  lessons     Lesson[]
  auditLogs   AuditLog[]
  parentSurveys ParentSurvey[]
  placementAssessmentAttempts PlacementAssessmentAttempt[]
  teacherQuizzes TeacherQuiz[]
  classEvents ClassEvent[]
  parentMeetings ParentMeeting[]
  communityPosts CommunityPost[]
  certificates Certificate[]
}

model User {
  id               String                    @id @default(uuid())
  schoolId         String?
  email            String                    @unique
  password         String
  role             Role                      @default(STUDENT)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  avatar           String?
  name             String?
  phone            String?
  behaviorScore    Float?
  emailVerified    Boolean                   @default(false)
  firstName        String?
  isActive         Boolean                   @default(true)
  lastName         String?
  streakDays       Int                       @default(0)
  lastActiveDate   DateTime?
  totalXP          Int                       @default(0)
  level            Int                       @default(1)
  school           School?                   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  assignments      Assignment[]
  attendance       Attendance[]
  geofenceAttendances GeofenceAttendance[]
  taughtClasses    Class[]                   @relation("ClassTeacher")
  classSessions    ClassSession[]
  conversations    ConversationParticipant[]
  enrollments      Enrollment[]
  uploadedFiles    File[]                    @relation("UploadedFiles")
  studentGrades    Grade[]
  invoices         Invoice[]
  createdLessons   Lesson[]
  sentMessages     Message[]
  messageReactions MessageReaction[]
  millionProfile   MillionProfile?           @relation("MillionUser")
  children         ParentStudent[]           @relation("ParentToStudent")
  parents          ParentStudent[]           @relation("StudentToParent")
  taughtSubjects   Subject[]                 @relation("SubjectTeacher")
  submissions      Submission[]
  notifications    Notification[]
  achievements     UserAchievement[]
  refreshTokens    RefreshToken[]
  authIdentities   AuthIdentity[]
  passwordResetCodes PasswordResetCode[]
  auditLogs        AuditLog[]
  gameScores       GameScore[]
  gameSessions     GameSession[]
  readingProgress  ReadingProgress[]
  automationRules  AutomationRule[]
  qrSessions       QrSession[]
  qrScans          QrScan[]
  userMilestones   UserMilestone[]
  generatedTemplates GeneratedTemplate[]
  smartProfile     SmartStudentProfile?
  skillMasteries   StudentSkillMastery[]
  xpTransactions   XpTransaction[]
  studentProfile   StudentProfile?
  studentLinkCodes StudentLinkCode[]
  parentSurveys    ParentSurvey[] @relation("ParentSurveyParent")
  childSurveys     ParentSurvey[] @relation("ParentSurveyStudent")
  submittedSurveys ParentSurvey[] @relation("ParentSurveyRespondent")
  placementAssessmentAttempts PlacementAssessmentAttempt[]
  teacherQuizzes TeacherQuiz[] @relation("QuizTeacher")
  quizAttempts QuizAttempt[]
  createdClassEvents ClassEvent[]
  parentMeetings ParentMeeting[] @relation("MeetingTeacher")
  parentMeetingBookings ParentMeetingBooking[] @relation("MeetingParent")
  meetingStudentBookings ParentMeetingBooking[]
  communityPosts CommunityPost[] @relation("CommunityAuthor")
  communityComments CommunityComment[]
  issuedCertificates Certificate[] @relation("CertificateIssuer")
  receivedCertificates Certificate[] @relation("CertificateStudent")

  @@index([role])
  @@index([isActive])
  @@index([schoolId])
}

model RegistrationArchive {
  id               String   @id @default(uuid())
  firebaseUid      String   @unique
  email            String
  fullName         String
  phone            String?
  role             Role
  schoolId         String?
  status           String   @default("PENDING")
  nationalId       String?
  specialization   String?
  yearsExperience  Int?
  homeroomClassId  String?
  avatarUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  verifiedAt       DateTime?
  homeroomClass    Class?   @relation("TeacherRegistrationHomeroom", fields: [homeroomClassId], references: [id], onDelete: SetNull)

  @@index([schoolId, status, createdAt])
  @@index([email, role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuthIdentity {
  id              String   @id @default(uuid())
  provider        String
  providerSubject String
  userId          String
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([provider, userId])
  @@index([userId])
}

model PasswordResetCode {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model RateLimitCounter {
  key          String   @id
  hits         Int      @default(0)
  resetAt      DateTime
  blockedUntil DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([resetAt])
  @@index([blockedUntil])
}

model ParentStudent {
  id           String  @id @default(uuid())
  parentId     String
  studentId    String
  relationship String?
  parent       User    @relation("ParentToStudent", fields: [parentId], references: [id])
  student      User    @relation("StudentToParent", fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

model StudentProfile {
  userId      String   @id
  gradeLevel  Int
  nationalId  String?  @unique
  dateOfBirth DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentLinkCode {
  id           String    @id @default(uuid())
  studentId    String
  tokenHash    String    @unique
  expiresAt    DateTime
  redeemedAt   DateTime?
  redeemedById String?
  createdAt    DateTime  @default(now())
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, redeemedAt, expiresAt])
}

model PlacementAssessmentAttempt {
  id             String   @id @default(uuid())
  schoolId       String
  studentId      String
  gradeLevel     Int
  assessmentKey  String
  answers        Json
  questionSnapshot Json
  correctCount   Int
  questionCount  Int
  score           Float
  completedAt     DateTime @default(now())
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assessmentKey])
  @@index([schoolId, completedAt])
  @@index([studentId, completedAt])
}

model ParentSurvey {
  id        String   @id @default(uuid())
  schoolId  String
  parentId  String?
  studentId String
  respondentId String
  respondentRole String @default("PARENT")
  answers   Json
  consentedAt DateTime
  consentVersion String @default("parent-survey-v1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent    User?    @relation("ParentSurveyParent", fields: [parentId], references: [id], onDelete: Cascade)
  student   User     @relation("ParentSurveyStudent", fields: [studentId], references: [id], onDelete: Cascade)
  respondent User    @relation("ParentSurveyRespondent", fields: [respondentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@unique([respondentId, studentId])
  @@index([schoolId, updatedAt])
  @@index([studentId])
}

model Class {
  id            String         @id @default(uuid())
  schoolId      String?
  name          String
  description   String?
  academicYear  String?
  teacherId     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  school        School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  attendance    Attendance[]
  geofenceAttendances GeofenceAttendance[]
  teacher       User?          @relation("ClassTeacher", fields: [teacherId], references: [id])
  sessions      ClassSession[]
  students      Enrollment[]
  subjects      Subject[]
  classSubjects ClassSubject[]
  scheduleEvents ScheduleEvent[]
  qrSessions     QrSession[]
  quizzes TeacherQuiz[]
  events ClassEvent[]
  parentMeetings ParentMeeting[]
  communityPosts CommunityPost[]
  teacherRegistrationArchives RegistrationArchive[] @relation("TeacherRegistrationHomeroom")

  @@index([schoolId])
}

model Subject {
  id            String         @id @default(uuid())
  schoolId      String?
  name          String
  code          String?
  description   String?
  classId       String
  teacherId     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  school        School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  assignments   Assignment[]
  grades        Grade[]
  lessons       Lesson[]
  class         Class          @relation(fields: [classId], references: [id])
  teacher       User?          @relation("SubjectTeacher", fields: [teacherId], references: [id])
  classSubjects ClassSubject[]
  games         Game[]
  questionBanks QuestionBank[]
  libraryItems  LibraryItem[]
  scheduleEvents ScheduleEvent[]
  skillNodes    SkillNode[]
  quizzes       TeacherQuiz[]

  @@index([schoolId])
}

model ClassSubject {
  id        String   @id @default(uuid())
  classId   String
  subjectId String
  teacherId String?
  schedule  Json?
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  classId    String
  enrolledAt DateTime @default(now())
  class      Class    @relation(fields: [classId], references: [id])
  student    User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, classId])
  @@index([classId])
}

model Lesson {
  id          String   @id @default(uuid())
  schoolId    String?
  title       String
  content     String?
  videoUrl    String?
  attachments String[]
  subjectId   String
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  author      User     @relation(fields: [authorId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id])

  @@index([schoolId])
}

model Assignment {
  id          String       @id @default(uuid())
  schoolId    String?
  title       String
  description String?
  dueDate     DateTime?
  subjectId   String
  teacherId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments String[]
  classId     String?
  maxScore    Float        @default(100)
  school      School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  subject     Subject      @relation(fields: [subjectId], references: [id])
  teacher     User         @relation(fields: [teacherId], references: [id])
  submissions Submission[]
  grades      Grade[]

  @@index([schoolId])
}

model Submission {
  id           String     @id @default(uuid())
  content      String?
  submittedAt  DateTime   @default(now())
  assignmentId String
  studentId    String
  attachments  String[]
  feedback     String?
  grade        Float?
  gradedAt     DateTime?
  score        Float?
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Grade {
  id        String   @id @default(uuid())
  assignmentId String?
  score     Float
  studentId String
  comments  String?
  createdAt DateTime @default(now())
  grade     Float
  maxScore  Float    @default(100)
  subjectId String
  updatedAt DateTime @updatedAt
  student   User     @relation(fields: [studentId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
}

model Attendance {
  id        String           @id @default(uuid())
  date      DateTime
  status    AttendanceStatus
  studentId String
  createdAt DateTime         @default(now())
  classId   String
  notes     String?
  updatedAt DateTime         @updatedAt
  class     Class            @relation(fields: [classId], references: [id])
  student   User             @relation(fields: [studentId], references: [id])

  @@unique([studentId, classId, date])
  @@index([classId, date])
  @@index([studentId])
}

model GeofenceAttendance {
  id               String        @id @default(uuid())
  studentId        String
  classId          String
  scheduleEventId  String
  attendanceDate   DateTime      @db.Date
  checkedInAt      DateTime      @default(now())
  distanceMeters   Float
  accuracyMeters   Float
  student          User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class            Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  scheduleEvent    ScheduleEvent @relation(fields: [scheduleEventId], references: [id], onDelete: Cascade)

  @@unique([studentId, scheduleEventId, attendanceDate])
  @@index([classId, attendanceDate])
  @@index([studentId, attendanceDate])
}

model Invoice {
  id          String        @id @default(uuid())
  schoolId    String?
  studentId   String
  amount      Float
  currency    String        @default("USD")
  status      InvoiceStatus @default(PENDING)
  stripeId    String?       @unique
  description String?
  metadata    Json?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  school      School?       @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  student     User          @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([schoolId])
}

model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

model File {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  uploadedBy   User     @relation("UploadedFiles", fields: [uploadedById], references: [id])
}

model MillionProfile {
  id           String         @id @default(cuid())
  userId       String         @unique
  displayName  String?
  currentLevel String?
  totalPoints  Float          @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation("MillionUser", fields: [userId], references: [id])
  scores       MillionScore[]

  @@map("MillionProfile")
}

model MillionScore {
  id            String         @id @default(cuid())
  profileId     String
  date          DateTime       @default(now())
  attendance    Float          @default(0)
  assignments   Float          @default(0)
  exams         Float          @default(0)
  participation Float          @default(0)
  total         Float          @default(0)
  profile       MillionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([date])
  @@map("MillionScore")
}

model Conversation {
  id           String                    @id @default(uuid())
  type         String                    @default("direct")
  title        String?
  description  String?
  avatarUrl    String?
  classId      String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  role           String       @default("member")
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String            @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  type           String            @default("text")
  attachments    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation(fields: [senderId], references: [id])
  reactions      MessageReaction[]

  @@index([conversationId, createdAt])
}

model MessageReaction {
  id        String  @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
}

model ClassSession {
  id         String   @id @default(uuid())
  title      String
  classId    String
  teacherId  String
  startTime  DateTime
  duration   Int
  isActive   Boolean  @default(false)
  meetingUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  class      Class    @relation(fields: [classId], references: [id])
  teacher    User     @relation(fields: [teacherId], references: [id])
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
  PRINCIPAL
  VICE_PRINCIPAL
  COUNSELOR
  SUPERVISOR
  ACCOUNTANT
  HR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InvoiceStatus {
  PENDING
  REQUIRES_ACTION
  PAID
  FAILED
  REFUNDED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  body      String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  data      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model Achievement {
  id          String            @id @default(uuid())
  key         String            @unique
  name        String
  description String
  icon        String
  xpReward    Int               @default(0)
  category    String            @default("general")
  createdAt   DateTime          @default(now())
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model XpTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String
  sourceId  String?  // Optional reference ID (e.g. assignment ID or attendance ID)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model DailyChallenge {
  id          String   @id @default(uuid())
  title       String
  description String?
  xpReward    Int      @default(100)
  date        DateTime @default(now())
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  subjectId   String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([isActive])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  xpEarned  Int      @default(0)
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ACHIEVEMENT
  REMINDER
  GRADE
  EARLY_INTERVENTION
}

// --- NEW DOMAINS ---

// 1. Educational Games
model Game {
  id          String   @id @default(uuid())
  title       String
  description String?
  url         String?
  subjectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subject     Subject  @relation(fields: [subjectId], references: [id])
  sessions    GameSession[]
  scores      GameScore[]
}

model GameSession {
  id        String   @id @default(uuid())
  gameId    String
  userId    String
  startedAt DateTime @default(now())
  endedAt   DateTime?
  duration  Int?     // in seconds
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GameScore {
  id        String   @id @default(uuid())
  gameId    String
  userId    String
  score     Float
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
}

// 2. Content Library
model LibraryCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  items       LibraryItem[]
}

model LibraryItem {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String   // "BOOK", "VIDEO", "ARTICLE"
  url         String
  coverUrl    String?
  categoryId  String
  subjectId   String?
  createdAt   DateTime @default(now())
  category    LibraryCategory @relation(fields: [categoryId], references: [id])
  subject     Subject? @relation(fields: [subjectId], references: [id])
  progress    ReadingProgress[]
}

model ReadingProgress {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  progress  Float    @default(0) // percentage 0-100
  lastReadAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

// 3. Student Schedule
model ScheduleEvent {
  id                 String              @id @default(uuid())
  classId            String
  subjectId          String
  dayOfWeek          Int                 // 0 = Sunday, 1 = Monday...
  periodNumber       Int                 @default(1)
  startTime          String              // e.g. "07:00"
  endTime            String              // e.g. "07:45"
  room               String?
  class              Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  geofenceAttendances GeofenceAttendance[]

  @@index([classId, dayOfWeek, periodNumber])
  @@index([classId, dayOfWeek, startTime])
}

// 4. QR Attendance
model QrSession {
  id        String   @id @default(uuid())
  classId   String
  teacherId String
  qrCode    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   User     @relation(fields: [teacherId], references: [id])
  scans     QrScan[]
}

model QrScan {
  id        String   @id @default(uuid())
  sessionId String
  studentId String
  scannedAt DateTime @default(now())
  status    String   // "VALID", "INVALID"
  session   QrSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

// 5. Teacher Automation
model AutomationRule {
  id          String   @id @default(uuid())
  teacherId   String
  name        String
  triggerType String   // "ABSENCE", "LOW_GRADE", "BEHAVIOR"
  condition   Json     // e.g. { operator: ">=", value: 3 }
  actionType  String   // "SEND_MESSAGE", "CREATE_TASK"
  actionData  Json     // e.g. { template: "..." }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastRunAt   DateTime?
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  logs        AutomationLog[]
}

model AutomationLog {
  id        String   @id @default(uuid())
  ruleId    String
  targetId  String   // userId of student/parent
  executedAt DateTime @default(now())
  status    String   // "SUCCESS", "FAILED"
  eventKey  String?  @unique
  details   Json?
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

model TeacherQuiz {
  id          String        @id @default(uuid())
  schoolId    String
  classId     String
  subjectId   String
  teacherId   String
  title       String
  instructions String?
  questions   Json
  dueAt       DateTime?
  published   Boolean       @default(false)
  showResults Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     User          @relation("QuizTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  attempts    QuizAttempt[]

  @@index([schoolId, classId, published])
  @@index([teacherId, createdAt])
}

model QuizAttempt {
  id          String     @id @default(uuid())
  quizId      String
  studentId   String
  answers     Json
  score       Float?
  maxScore    Float
  feedback    String?
  submittedAt DateTime   @default(now())
  quiz        TeacherQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([studentId, submittedAt])
}

model ClassEvent {
  id                 String   @id @default(uuid())
  schoolId           String
  classId            String
  teacherId          String
  title              String
  description        String?
  eventType          String   @default("CLASS_EVENT")
  startsAt           DateTime?
  photoReferences    String[] @default([])
  published          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class              Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher            User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId, classId, startsAt])
}

model ParentMeeting {
  id            String   @id @default(uuid())
  schoolId      String
  classId       String
  teacherId     String
  title         String
  description   String?
  startsAt      DateTime
  endsAt        DateTime
  mode          String   @default("IN_PERSON")
  location      String?
  meetingUrl    String?
  maxBookings   Int      @default(1)
  isOpen        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher       User     @relation("MeetingTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  bookings      ParentMeetingBooking[]

  @@index([schoolId, classId, startsAt])
  @@index([teacherId, startsAt])
}

model ParentMeetingBooking {
  id        String   @id @default(uuid())
  meetingId String
  parentId  String
  studentId String
  note      String?
  status    String   @default("BOOKED")
  createdAt DateTime @default(now())
  meeting   ParentMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  parent    User     @relation("MeetingParent", fields: [parentId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([meetingId, parentId, studentId])
  @@index([parentId, createdAt])
}

model CommunityPost {
  id                  String   @id @default(uuid())
  schoolId            String
  classId             String?
  authorId            String
  title               String
  body                String
  attachmentReferences String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class               Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  author              User     @relation("CommunityAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments            CommunityComment[]

  @@index([schoolId, classId, createdAt])
}

model CommunityComment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Certificate {
  id          String   @id @default(uuid())
  schoolId    String
  studentId   String
  issuerId    String
  serial      String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now())
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     User     @relation("CertificateStudent", fields: [studentId], references: [id], onDelete: Cascade)
  issuer      User     @relation("CertificateIssuer", fields: [issuerId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId, createdAt])
}

// 6. Content Generator & AI
model QuestionBank {
  id          String   @id @default(uuid())
  subjectId   String
  topic       String
  questions   Json     // Array of questions
  createdAt   DateTime @default(now())
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model GeneratedTemplate {
  id          String   @id @default(uuid())
  teacherId   String
  title       String
  content     String
  type        String   // "LESSON_PLAN", "QUIZ"
  createdAt   DateTime @default(now())
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

// 7. Million Journey
model JourneyMilestone {
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int
  xpRequired  Int
  rewardType  String?  // "BADGE", "AVATAR"
  rewardId    String?
  userMilestones UserMilestone[]
}

model UserMilestone {
  id          String   @id @default(uuid())
  userId      String
  milestoneId String
  unlockedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone   JourneyMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([userId, milestoneId])
}

// 8. Smart Student Profile & Knowledge Map
model SmartStudentProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  learningStyle   String?  // VISUAL, LOGICAL, SOCIAL, etc.
  strengthSubjects String[]
  weakSubjects    String[]
  performanceTrend String? // IMPROVING, STABLE, DECLINING
  lastAnalyzedAt  DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SkillNode {
  id          String   @id @default(uuid())
  subjectId   String
  name        String
  description String?
  masteries   StudentSkillMastery[]
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model StudentSkillMastery {
  id          String   @id @default(uuid())
  studentId   String
  skillNodeId String
  masteryLevel String  // MASTERED, IN_PROGRESS, NOT_STARTED
  updatedAt   DateTime @updatedAt
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillNode   SkillNode @relation(fields: [skillNodeId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillNodeId])
}
