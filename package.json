{
  "name": "nexus-edu-platforms",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:api": "turbo run build --filter=api",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types && npm run typecheck --workspace=mobile"
  },
  "devDependencies": {
    "@emnapi/runtime": "^1.11.3",
    "postcss": "^8.5.28",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.19",
    "turbo": "^2.6.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "proxy-addr": "2.0.8",
    "next": "16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-android-arm64": "0.1.80",
    "@napi-rs/canvas-darwin-arm64": "0.1.80",
    "@napi-rs/canvas-darwin-x64": "0.1.80",
    "@napi-rs/canvas-linux-arm-gnueabihf": "0.1.80",
    "@napi-rs/canvas-linux-arm64-gnu": "0.1.80",
    "@napi-rs/canvas-linux-arm64-musl": "0.1.80",
    "@napi-rs/canvas-linux-riscv64-gnu": "0.1.80",
    "@napi-rs/canvas-linux-x64-gnu": "0.1.80",
    "@napi-rs/canvas-linux-x64-musl": "0.1.80",
    "@napi-rs/canvas-win32-x64-msvc": "0.1.80",
    "@parcel/watcher-android-arm64": "2.6.0",
    "@parcel/watcher-darwin-arm64": "2.6.0",
    "@parcel/watcher-darwin-x64": "2.6.0",
    "@parcel/watcher-freebsd-x64": "2.6.0",
    "@parcel/watcher-linux-arm-glibc": "2.6.0",
    "@parcel/watcher-linux-arm-musl": "2.6.0",
    "@parcel/watcher-linux-arm64-glibc": "2.6.0",
    "@parcel/watcher-linux-arm64-musl": "2.6.0",
    "@parcel/watcher-linux-x64-glibc": "2.6.0",
    "@parcel/watcher-linux-x64-musl": "2.6.0",
    "@parcel/watcher-win32-arm64": "2.6.0",
    "@parcel/watcher-win32-x64": "2.6.0",
    "@swc/core-darwin-arm64": "1.16.13",
    "@swc/core-darwin-x64": "1.16.13",
    "@swc/core-linux-arm-gnueabihf": "1.16.13",
    "@swc/core-linux-arm64-gnu": "1.16.13",
    "@swc/core-linux-arm64-musl": "1.16.13",
    "@swc/core-linux-ppc64-gnu": "1.16.13",
    "@swc/core-linux-s390x-gnu": "1.16.13",
    "@swc/core-linux-x64-gnu": "1.16.13",
    "@swc/core-linux-x64-musl": "1.16.13",
    "@swc/core-win32-arm64-msvc": "1.16.13",
    "@swc/core-win32-ia32-msvc": "1.16.13",
    "@swc/core-win32-x64-msvc": "1.16.13"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "postcss-selector-parser": "7.1.7",
    "handlebars": "4.7.10",
    "@grpc/grpc-js": "1.14.6",
    "uuid": "11.1.1",
    "deepmerge-ts": "8.0.2",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "5.5.0"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    },
    "query-string": {
      "decode-uri-component": "0.5.0"
    }
  }
}
