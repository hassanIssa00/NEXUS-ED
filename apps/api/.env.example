# ===================
# Database
# ===================
DATABASE_URL="postgresql://postgres:password@localhost:5432/nexus_edu?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/nexus_edu?schema=public"

# Public student/parent registration: set an existing active school.
# If omitted, registration works only when the database has exactly one active school.
PUBLIC_SCHOOL_ID=""
PUBLIC_SCHOOL_SLUG="al-ikhlas-jeddah"
NEXUS_SCHOOL_NAME="مدارس الإخلاص الأهلية بجدة"

# Optional one-time initial administrator. Set both values only for first provisioning.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=replace-with-secure-admin-password
BOOTSTRAP_ADMIN_NAME=""

# ===================
# JWT Configuration
# ===================
# Generate each value separately with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Access token (short-lived, 15 minutes)
JWT_SECRET=replace-with-long-random-jwt-secret

# Refresh token (long-lived, 7 days)
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret

# ===================
# Server Configuration
# ===================
NODE_ENV="development"
PORT=4000

# Comma-separated approved meeting hosts, for example meet.school.edu.sa
MEETING_ALLOWED_HOSTS=

# ===================
# Frontend origin allowlist (comma-separated)
# ===================
FRONTEND_URL="http://localhost:3005"
FIREBASE_PROJECT_ID="nexus-edu-ikhlas-jeddah-2026"
# Server-only teacher signup code. Configure a strong random value in Vercel API Production.
TEACHER_REGISTRATION_CODE=""
# Google OAuth web client ID used by Firebase Google Sign-In and API token verification.
GOOGLE_CLIENT_ID="your-google-oauth-web-client-id.apps.googleusercontent.com"

# ===================
# File Upload
# ===================
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR="./uploads"

# ===================
# Email Service (Gmail API OAuth2 preferred, SMTP fallback)
# ===================

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM_NAME="Nexus EDU"
SMTP_FROM_EMAIL="your-verified-sender@example.com"

# Preferred Gmail API path when App Passwords are unavailable.
# Enable Gmail API, authorize https://www.googleapis.com/auth/gmail.send, then
# set all three OAuth values in the deployment secret manager. Never commit them.
GMAIL_OAUTH_CLIENT_ID="your-google-oauth-client-id"
GMAIL_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"
GMAIL_OAUTH_REFRESH_TOKEN="your-google-oauth-refresh-token"

# Alternative: SendGrid (for production)
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="SG.your-sendgrid-api-key"

# Email Features
EMAIL_NOTIFICATIONS_ENABLED=true

# ===================
# Web Push (VAPID)
# ===================
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-public-key"
VAPID_PRIVATE_KEY="your-private-key"
VAPID_SUBJECT="mailto:admin@nexus.masarplatform.org"

# ===================
# WhatsApp (Twilio)
# ===================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# ===================
# Optional AI, payments, and queue workers
# ===================
# Optional: only needed for educational image generation; Groq handles text and image analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Local-only Nexus meetings SFU. The dev key pair only works with --dev locally.
LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=wss://your-livekit-domain.example
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_RECORDING_S3_ENDPOINT=
LIVEKIT_RECORDING_S3_ACCESS_KEY=
LIVEKIT_RECORDING_S3_SECRET=
LIVEKIT_RECORDING_S3_REGION=ap-southeast-1
LIVEKIT_RECORDING_S3_BUCKET=assignments

# Optional Supabase integration (only if explicitly enabled in the deployment).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
