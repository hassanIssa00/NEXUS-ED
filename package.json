{
  "name": "nexus-edu-platforms",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:api": "turbo run build --filter=api",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types && npm run typecheck --workspace=mobile"
  },
  "devDependencies": {
    "@emnapi/runtime": "^1.11.3",
    "postcss": "^8.5.28",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.19",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@grpc/grpc-js": "1.14.5",
    "expo-router": "57.0.24",
    "next": "^16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    }
  }
}
