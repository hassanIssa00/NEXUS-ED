{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NEXUS_SELF_HOSTED_BUILD",
    "NEXUS_API_ORIGIN",
    "NEXT_PUBLIC_API_URL",
    "DATABASE_URL",
    "DIRECT_URL",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "FRONTEND_URL",
    "FIREBASE_PROJECT_ID",
    "PUBLIC_SCHOOL_SLUG",
    "NEXUS_SCHOOL_NAME"
  ],
  "globalPassThroughEnv": ["SWC_NATIVE_BINDING_CACHE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
