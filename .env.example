# ============================================
# Million Platform - Environment Variables Template
# ============================================
# Copy this to .env in the root and fill in the values.

# ------------ Database ------------
DATABASE_URL=postgresql://user:password@localhost:5432/million_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=million_db

# ------------ Redis ------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ------------ Authentication ------------
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_jwt_secret_here
JWT_EXPIRATION=86400

# ------------ Server Configuration ------------
NODE_ENV=development
PORT=3001

# ------------ External Services ------------
# AI Features
OPENAI_API_KEY=sk_...

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_...
STRIPE_PUBLIC_KEY=pk_...
NEXT_PUBLIC_STRIPE_KEY=pk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (Auth/Storage)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------ Frontend Configuration ------------
FRONTEND_URL=http://localhost:3002,http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false
MEETING_ALLOWED_HOSTS=

# Optional Nexus Firebase project (must be separate from Masar's Firebase project)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ------------ Feature Flags ------------
ENABLE_MILLION_DIALOGUE=true
ENABLE_AI_QUESTIONS=false
